# --- Security: Protect sensitive files ---
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<Files "\.env">
    Require all denied
</Files>

# Block directory listing
Options -Indexes

# Rewrite rules
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to admin/data directly from web
    RewriteRule ^admin/data/ - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule ^\.env - [F,L]

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # InfinityFree: handle subdirectory install if needed
    # RewriteBase /
</IfModule>

# Protect uploads directory from PHP execution
<IfModule mod_alias.c>
    <Directory "uploads">
        <FilesMatch "\.php$">
            Require all denied
        </FilesMatch>
    </Directory>
</IfModule>
